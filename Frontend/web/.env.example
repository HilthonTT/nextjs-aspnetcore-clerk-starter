# Copy to .env.local and fill in with values from https://dashboard.clerk.com
# .env.local is gitignored — never commit real keys.

# Clerk keys (API Keys page in the Clerk dashboard)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<your-clerk-publishable-key>
CLERK_SECRET_KEY=<your-clerk-secret-key>

# Where Clerk's hosted pages live in this app
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Base URL of the ASP.NET Core API. Server-side only, so no NEXT_PUBLIC_ prefix.
# Match the profile you run the API with (see Backend/ClerkAPI/Properties/launchSettings.json).
#
# Use the HTTP URL locally. These calls are server-to-server and never leave your machine, and
# Node's fetch does not trust the ASP.NET Core dev certificate. Pointing this at
# https://localhost:7080 fails with DEPTH_ZERO_SELF_SIGNED_CERT unless you also trust the cert
# (`dotnet dev-certs https --trust`) and start Next.js with `node --use-system-ca`.
API_URL=http://localhost:5014
