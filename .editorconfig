root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csproj,props,targets}]
indent_size = 4

[*.sln]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

# C# conventions
[*.cs]
csharp_new_line_before_open_brace = all
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_sort_system_directives_first = true
dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion

# Analyzer rules. The backend builds with AnalysisLevel=latest-recommended and warnings as
# errors (see Backend/Directory.Build.props), so anything turned off here is turned off
# deliberately and with a reason.
#
# CA1859: suggests swapping IConfiguration for the concrete ConfigurationManager in private
# helpers. The interface is the right contract here, and the "performance" gain is not
# measurable at startup.
dotnet_diagnostic.CA1859.severity = none
